# ── PACOS v1 configuration ────────────────────────────────────────────────
# Copy this file to `.env` and fill in the blanks. Never commit `.env`.

# ── Nemotron (generation model) ───────────────────────────────────────────
# Get a free key at https://build.nvidia.com  → any Nemotron model → "Get API Key"
NVIDIA_API_KEY=

# The NVIDIA NIM endpoint is OpenAI-compatible; leave as-is unless self-hosting.
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1

# Any Nemotron instruct model served by your endpoint. Good default:
#   nvidia/nemotron-3-super-120b-a12b   (current family; clean output)
# Avoid retired models (llama-3.1-nemotron-70b-instruct now 404s) and
# reasoning-mode models that return empty content without /no_think
# (llama-3.3-nemotron-super-49b-v1.5).
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Embeddings (Hugging Face) ─────────────────────────────────────────────
# Model used for embedding leads/assets. BAAI/bge-m3 is multilingual, 1024-dim.
EMBEDDING_MODEL=BAAI/bge-m3
# Hugging Face token (https://huggingface.co/settings/tokens) — needed for the
# HF Inference API; leave empty if running the model locally.
HF_TOKEN=

# ── Files ─────────────────────────────────────────────────────────────────
LEADS_CSV_PATH=data/leads.csv
OUTPUT_DIR=output
TRACKER_CSV_PATH=tracker.csv
NEW_JOBS_CSV_PATH=new_jobs.csv
BASE_CV_PATH=data/base_cv.txt

# ── Candidate identity (used to sign outreach) ────────────────────────────
CANDIDATE_NAME=Prasanna Kulkarni
CANDIDATE_HEADLINE=Aspiring AI Engineer
CANDIDATE_EMAIL=kulkarniprasanna25@gmail.com
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/prasanna-kulkarni-032650180/

# ── Follow-up policy ──────────────────────────────────────────────────────
FOLLOW_UP_DAYS=5

# ── Gmail Inbox Monitor (Layer 2, read-only) ──────────────────────────────
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# ── Cloud deployment (docs/DEPLOYMENT.md) ─────────────────────────────────
# Tracker backend. EMPTY (the default) = local SQLite file — leave it empty
# for local/exe usage. Set to a Postgres URL (e.g. from neon.tech) only in
# cloud deployments, where the filesystem is ephemeral.
DATABASE_URL=

# When set, every /api call must carry `Authorization: Bearer <token>` — the
# dashboard prompts for it on first load. Leave EMPTY for local/exe usage.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PACOS_AUTH_TOKEN=

# Extra allowed browser origins (comma-separated). Only needed if the
# dashboard is hosted on a *different* domain than the API; the recommended
# single-service deployment serves both from one origin and can ignore this.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
